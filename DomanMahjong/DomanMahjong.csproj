<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>iTaterSalad</Author>
    <Name>Doman Mahjong</Name>
    <Punchline>Improve your Mahjong game by reading!</Punchline>
    <Description>Attaches an explanation of common Riichi Mahjong terms to the Mahjong GUI.</Description>
    <RepoUrl>https://github.com/iTaterLove/DomanMahjong</RepoUrl>
    <Tags>mahjong;plugin;yakuman</Tags>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Pages\*.txt">
      <Link>Pages/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
        <Content Include="..\Data\*.png;..\Data\*.jpg;..\Data\*.jpeg">
      <Link>Data\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
